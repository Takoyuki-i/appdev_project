<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Log in - CSPC Events Desk</title>
    <link rel="stylesheet" href="/css/login.css">
</head>
<body>
    <main class="auth">
        <aside class="brand">
            <img src="/images/cspc-seal.png" alt="Camarines Sur Polytechnic Colleges seal">
            <div class="bt">CSPC <span>Events</span> Desk</div>
            <p class="bn">Camarines Sur Polytechnic Colleges</p>
            <p class="pnote brand-description">Find campus events, reserve your spot, and keep every club in one single calendar.</p>
        </aside>

        <section class="acard" aria-labelledby="login-heading">
            <h2 id="login-heading">Welcome back</h2>
            <p class="pnote">Log in to your CSPC Events Desk account.</p>

            <% if (typeof error !== 'undefined' && error) { %>
                <p class="err" role="alert"><%= error %></p>
            <% } %>

            <form action="/login" method="POST">
                <label class="f" for="email">Email
                    <input
                        id="email"
                        name="email"
                        type="text"
                        required
                        autocomplete="email"
                    >
                </label>

                <label class="f" for="password">Password
                    <input
                        id="password"
                        name="password"
                        type="password"
                        required
                        autocomplete="current-password"
                    >
                </label>

                <button class="b login-button" type="submit">Log in</button>
            </form>

            <p class="signup-link">Don't have an account? <a href="/register">Sign up</a></p>
        </section>
    </main>
</body>
</html>