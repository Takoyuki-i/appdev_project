<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Admin Review | CSPC Events Desk</title>
  <link rel="stylesheet" href="/css/admin.css">
  <link href="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.19/index.global.min.css" rel="stylesheet">
  <script src="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.19/index.global.min.js" defer></script>
  <script src="/js/admin.js" defer></script>
</head>
<body>
  <div class="admin-shell">
    <aside class="sidebar">
      <a class="brand" href="/" aria-label="CSPC Events Desk homepage">
        <img src="/images/cspc-seal.png" alt="CSPC seal" onerror="this.hidden=true">
        <span><strong>CSPC <em>Events</em> Desk</strong><small>ADMINISTRATION</small></span>
      </a>
      <div class="admin-label"><span class="admin-dot"></span> ADMIN WORKSPACE</div>
      <nav class="side-nav" aria-label="Admin navigation">
        <button class="nav-item active" type="button" data-view="approvals"><span class="nav-icon">✓</span> Event proposals <span class="nav-count" id="pending-count">—</span></button>
        <button class="nav-item" type="button" data-view="calendar"><span class="nav-icon">▦</span> Calendar</button>
      </nav>
      <div class="sidebar-note">
        <span class="note-mark">!</span>
        <strong>Your role</strong>
        <p>Review and approve or reject event proposals. Approved events are published to the public calendar.</p>
      </div>
    </aside>

    <main class="main-area">
      <header class="topbar">
        <div>
          <p class="eyebrow">CSPC EVENTS DESK / ADMIN</p>
          <h1 id="page-title">Event proposals</h1>
          <p class="page-subtitle" id="page-subtitle">Review submissions before they appear on the public calendar.</p>
        </div>
        <div class="top-actions">
          <span class="admin-pill"><span></span> Admin</span>
          <button class="icon-button" id="refresh-button" type="button" title="Refresh proposals" aria-label="Refresh proposals">↻</button>
          <form action="/logout" method="POST" class="logout-form">
            <button class="logout-link" type="submit">Log out</button>
          </form>
        </div>
      </header>

      <section class="stats-grid" aria-label="Proposal summary">
        <article class="stat-card"><span class="stat-label">Awaiting review</span><strong id="stat-pending">—</strong><span class="stat-foot">Requires your decision</span></article>
        <article class="stat-card"><span class="stat-label">Approved</span><strong id="stat-approved">—</strong><span class="stat-foot">Eligible for publication</span></article>
        <article class="stat-card"><span class="stat-label">Rejected</span><strong id="stat-rejected">—</strong><span class="stat-foot">Not shown publicly</span></article>
      </section>

      <section id="approvals-view" class="content-view">
        <div class="section-heading">
          <div><h2>Submissions to review</h2><p>Check the event details before making a decision.</p></div>
          <label class="search-box"><span aria-hidden="true">⌕</span><input id="proposal-search" type="search" placeholder="Search proposals" aria-label="Search proposals"></label>
        </div>
        <div class="filter-row" role="group" aria-label="Proposal status filter">
          <button class="filter-button active" type="button" data-status="pending">Pending</button>
          <button class="filter-button" type="button" data-status="approved">Approved</button>
          <button class="filter-button" type="button" data-status="rejected">Rejected</button>
          <button class="filter-button" type="button" data-status="cancelled">Cancelled</button>
        </div>
        <div id="proposal-list" class="proposal-list" aria-live="polite">
          <div class="loading-state"><span class="spinner"></span> Loading event proposals…</div>
        </div>
      </section>

      <section id="calendar-view" class="content-view" hidden>
        <div class="section-heading calendar-heading"><div><h2>Events calendar</h2><p>This uses the same FullCalendar library as the public homepage and shows approved events only.</p></div></div>
        <div class="calendar-panel"><div id="admin-calendar"></div></div>
      </section>

      <footer class="page-footer"><span>CSPC Events Desk</span><span>Admin review workspace</span></footer>
    </main>
  </div>

  <dialog id="decision-dialog" class="decision-dialog">
    <form id="decision-form">
      <div class="dialog-mark" id="dialog-mark">✓</div>
      <h2 id="dialog-title">Approve this event?</h2>
      <p id="dialog-description">This decision will update the event proposal status.</p>
      <label class="field-label" id="reason-label" for="decision-reason">Reason for declining <span>(optional)</span></label>
      <textarea id="decision-reason" rows="3" maxlength="500" placeholder="Explain what needs to be changed…"></textarea>
      <p id="dialog-error" class="dialog-error" role="alert"></p>
      <div class="dialog-actions"><button class="button secondary" id="cancel-decision" type="button">Cancel</button><button class="button primary" id="confirm-decision" type="submit">Confirm</button></div>
    </form>
  </dialog>

  <div id="toast" class="toast" role="status" aria-live="polite"></div>
</body>
</html>
